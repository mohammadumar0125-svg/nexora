# ==============================================================================
# NEXORA Business Operating System — Enterprise Environment Template
# ==============================================================================

APP_ENV=development
PORT=8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL 16 (Application uses least-privilege api_role with FORCE ROW LEVEL SECURITY)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexora_enterprise
POSTGRES_TEST_DB=nexora_enterprise_test
POSTGRES_USER=nexora_owner
POSTGRES_PASSWORD=nexora_owner_secret
DB_API_USER=api_role
DB_API_PASSWORD=api_secret_pass

# Optional override URLs (recommended for Cloud SQL / Secret Manager)
# DATABASE_URL=postgresql://api_role:CHANGE_ME@/nexora_enterprise?host=/cloudsql/PROJECT:REGION:INSTANCE
# MIGRATION_DATABASE_URL=postgresql://nexora_owner:CHANGE_ME@/nexora_enterprise?host=/cloudsql/PROJECT:REGION:INSTANCE

# AI Intelligence (Server-side only — never expose via VITE_*)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash

# Private File Storage Adapter (local | gcs)
STORAGE_BACKEND=local
GCS_BUCKET_NAME=
MAX_UPLOAD_BYTES=5242880

# --- Hosted deploy (Render + Neon) ---
# MIGRATION_DATABASE_URL=postgresql://OWNER:PASSWORD@HOST/DBNAME?sslmode=require   (owner/direct URL)
# DB_API_PASSWORD=choose-a-long-random-password   (api_role is created/updated automatically on boot)
# SEED_SAMPLE_WORKSPACE=true
# Do NOT set DATABASE_URL on Render: it is derived automatically as api_role.
